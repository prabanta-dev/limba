/*
 * tokens.def - the tokens of Luxia 0.
 *
 *   LX_TOKEN(name, text)   literals, punctuation, operators
 *   LX_KEYWORD(name, text) the reserved words, lowercase only
 *
 * The keywords are interned first in the name table, in this order, so
 * the id of a name tells at once whether it is a keyword and which:
 * kind = LX_KW_FIRST + id. The list is the one of the specification,
 * sorted.
 */
LX_TOKEN(EOF, "end of file")
LX_TOKEN(IDENT, "name")
LX_TOKEN(INT, "integer")
LX_TOKEN(REAL, "real number")
LX_TOKEN(CHAR, "character")
LX_TOKEN(STRING, "string")
LX_TOKEN(PLUS, "+")
LX_TOKEN(MINUS, "-")
LX_TOKEN(STAR, "*")
LX_TOKEN(SLASH, "/")
LX_TOKEN(POWER, "**")
LX_TOKEN(AMP, "&")
LX_TOKEN(EQ, "=")
LX_TOKEN(NE, "<>")
LX_TOKEN(LT, "<")
LX_TOKEN(LE, "<=")
LX_TOKEN(GT, ">")
LX_TOKEN(GE, ">=")
LX_TOKEN(ASSIGN, ":=")
LX_TOKEN(COLON, ":")
LX_TOKEN(SEMI, ";")
LX_TOKEN(COMMA, ",")
LX_TOKEN(DOT, ".")
LX_TOKEN(DOTDOT, "..")
LX_TOKEN(LPAREN, "(")
LX_TOKEN(RPAREN, ")")
LX_TOKEN(LBRACK, "[")
LX_TOKEN(RBRACK, "]")
LX_TOKEN(CARET, "^")
LX_KEYWORD(ABS, "abs")
LX_KEYWORD(AND, "and")
LX_KEYWORD(ARRAY, "array")
LX_KEYWORD(BEGIN, "begin")
LX_KEYWORD(CASE, "case")
LX_KEYWORD(CONST, "const")
LX_KEYWORD(CONTINUE, "continue")
LX_KEYWORD(DIV, "div")
LX_KEYWORD(DO, "do")
LX_KEYWORD(DOWNTO, "downto")
LX_KEYWORD(ELSE, "else")
LX_KEYWORD(ELSIF, "elsif")
LX_KEYWORD(END, "end")
LX_KEYWORD(EXIT, "exit")
LX_KEYWORD(EXPORT, "export")
LX_KEYWORD(FALSE, "false")
LX_KEYWORD(FOR, "for")
LX_KEYWORD(FUNCTION, "function")
LX_KEYWORD(IF, "if")
LX_KEYWORD(IMPORT, "import")
LX_KEYWORD(IN, "in")
LX_KEYWORD(LOOP, "loop")
LX_KEYWORD(MOD, "mod")
LX_KEYWORD(MODULE, "module")
LX_KEYWORD(NEW, "new")
LX_KEYWORD(NIL, "nil")
LX_KEYWORD(NOT, "not")
LX_KEYWORD(OF, "of")
LX_KEYWORD(OR, "or")
LX_KEYWORD(OUT, "out")
LX_KEYWORD(PRAGMA, "pragma")
LX_KEYWORD(PROCEDURE, "procedure")
LX_KEYWORD(PROGRAM, "program")
LX_KEYWORD(RANGE, "range")
LX_KEYWORD(RECORD, "record")
LX_KEYWORD(REM, "rem")
LX_KEYWORD(REPEAT, "repeat")
LX_KEYWORD(RETURN, "return")
LX_KEYWORD(SHL, "shl")
LX_KEYWORD(SHR, "shr")
LX_KEYWORD(THEN, "then")
LX_KEYWORD(TO, "to")
LX_KEYWORD(TRUE, "true")
LX_KEYWORD(TYPE, "type")
LX_KEYWORD(UNTIL, "until")
LX_KEYWORD(VAR, "var")
LX_KEYWORD(WHEN, "when")
LX_KEYWORD(WHILE, "while")
LX_KEYWORD(XOR, "xor")
