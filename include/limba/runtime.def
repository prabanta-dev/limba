/*
 * runtime.def - the functions of the run-time library that the IR calls
 * with call.rt, read by Limba and by Meri. A draft: the Luxia library will
 * fill it family by family.
 *
 *   LIMBA_RT(name, text, signature, attributes)
 *
 * name       the enumerator is LIMBA_RT_<name>
 * text       the spelling in the text form, call.rt str_len(v1)
 * signature  "(types) -> type" in the text syntax of the IR, scalar types
 *            only; "..." for variadic
 * attributes LIMBA_RTA_* in ir.h: what an optimisation may assume
 *
 * The order is the numbering of the binary form, and the whole table has a
 * fingerprint in every .lir: Meri refuses an IR written against a table it
 * does not know. Add at the end. No graphics and no audio here (R11).
 */

/* console */
LIMBA_RT(PRINT_I64, "print_i64", "(i64) -> void", LIMBA_RTA_IO)
/* the text of a real is limba/fmt.h, byte for byte: limba_fmt_f64 for
   print_f64 and str_from_f64, limba_fmt_f32 for print_f32 and
   str_from_f32, limba_fmt_f64_fixed for str_from_f64_fixed */
LIMBA_RT(PRINT_F64, "print_f64", "(f64) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_STR, "print_str", "(str) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_NL, "print_nl", "() -> void", LIMBA_RTA_IO)

/* strings */
LIMBA_RT(STR_CONCAT, "str_concat", "(str, str) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(STR_LEN, "str_len", "(str) -> i64", LIMBA_RTA_PURE)
LIMBA_RT(STR_CMP, "str_cmp", "(str, str) -> i32", LIMBA_RTA_PURE)
LIMBA_RT(STR_FROM_I64, "str_from_i64", "(i64) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(STR_FROM_F64, "str_from_f64", "(f64) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(STR_MID, "str_mid", "(str, i64, i64) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(STR_PTR, "str_ptr", "(str) -> ptr", LIMBA_RTA_PURE)

/* memory of the program: Allocate, Deallocate */
LIMBA_RT(MEM_ALLOC, "mem_alloc", "(i64) -> ptr", LIMBA_RTA_ALLOC)
/* mem_free(null) does nothing; anything else that is not a live block of
   mem_alloc is the trap INVALID_FREE */
LIMBA_RT(MEM_FREE, "mem_free", "(ptr) -> void",
         LIMBA_RTA_WRITES_MEM | LIMBA_RTA_MAY_TRAP)

/* mathematics */
LIMBA_RT(MATH_SQRT, "math_sqrt", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_SIN, "math_sin", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_COS, "math_cos", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_POW, "math_pow", "(f64, f64) -> f64", LIMBA_RTA_PURE)

/* Luxia 0: output, formatted output, input, the command line */
LIMBA_RT(PRINT_U64, "print_u64", "(i64) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_BOOL, "print_bool", "(i1) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_CHAR, "print_char", "(i32) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_BYTE, "print_byte", "(i8) -> void", LIMBA_RTA_IO)
LIMBA_RT(PRINT_STR_W, "print_str_w", "(str, i32) -> void", LIMBA_RTA_IO)
LIMBA_RT(STR_FROM_U64, "str_from_u64", "(i64) -> str", LIMBA_RTA_ALLOC)
/* x:width:decimals of a real (a Float32 widened exactly): fixed notation,
   limba_fmt_f64_fixed; the width is print_str_w, in code points */
LIMBA_RT(STR_FROM_F64_FIXED, "str_from_f64_fixed", "(f64, i32) -> str",
         LIMBA_RTA_ALLOC)
LIMBA_RT(STR_FROM_CHAR, "str_from_char", "(i32) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(STR_FROM_BOOL, "str_from_bool", "(i1) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(READ_LINE, "read_line", "(ptr) -> i1",
         LIMBA_RTA_IO | LIMBA_RTA_ALLOC | LIMBA_RTA_WRITES_MEM)
/* val (luxia_0.md § 9): a number of the text, spaces and tabs around, a
   sign, then a literal of Luxia; str_to_i64 takes an integer in lo..hi
   (the last two operands), str_to_f64 an integer or a real rounded once
   to f64 (or inf, -inf, nan), and writes it at the pointer; false, and
   nothing written, for a text that is no such number */
LIMBA_RT(STR_TO_I64, "str_to_i64", "(str, ptr, i64, i64) -> i1",
         LIMBA_RTA_WRITES_MEM)
LIMBA_RT(STR_TO_F64, "str_to_f64", "(str, ptr) -> i1", LIMBA_RTA_WRITES_MEM)
LIMBA_RT(ARG_COUNT, "arg_count", "() -> i32", LIMBA_RTA_IO)
LIMBA_RT(ARG, "arg", "(i32) -> str", LIMBA_RTA_IO | LIMBA_RTA_ALLOC)
LIMBA_RT(HALT, "halt", "(i32) -> void", LIMBA_RTA_IO | LIMBA_RTA_NORETURN)
/* Luxia 0: mathematics */
LIMBA_RT(MATH_TAN, "math_tan", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_ATAN, "math_atan", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_EXP, "math_exp", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_LN, "math_ln", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_TRUNC, "math_trunc", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_FLOOR, "math_floor", "(f64) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(MATH_CEIL, "math_ceil", "(f64) -> f64", LIMBA_RTA_PURE)
/* the powers: the exponent is a number without a sign (a negative one is
   refused before); int_pow and uint_pow trap on overflow of 64 bits */
LIMBA_RT(INT_POW, "int_pow", "(i64, i64) -> i64",
         LIMBA_RTA_PURE | LIMBA_RTA_MAY_TRAP)
/* the base without a sign */
LIMBA_RT(UINT_POW, "uint_pow", "(i64, i64) -> i64",
         LIMBA_RTA_PURE | LIMBA_RTA_MAY_TRAP)
/* modulo 2^64 */
LIMBA_RT(BITS_POW, "bits_pow", "(i64, i64) -> i64", LIMBA_RTA_PURE)
/* val: as str_to_i64, lo..hi without a sign (-0 is 0); as str_to_f64,
   rounded once to f32 */
LIMBA_RT(STR_TO_U64, "str_to_u64", "(str, ptr, i64, i64) -> i1",
         LIMBA_RTA_WRITES_MEM)
LIMBA_RT(STR_TO_F32, "str_to_f32", "(str, ptr) -> i1", LIMBA_RTA_WRITES_MEM)
/* a Float32 in the shortest form that reads back as a Float32
   (limba_fmt_f32) */
LIMBA_RT(PRINT_F32, "print_f32", "(f32) -> void", LIMBA_RTA_IO)
LIMBA_RT(STR_FROM_F32, "str_from_f32", "(f32) -> str", LIMBA_RTA_ALLOC)
/* is p a live block of mem_alloc (its start, not freed)? The dangling
   check: check ptr_live(p), 105 right before an access through p */
LIMBA_RT(PTR_LIVE, "ptr_live", "(ptr) -> i1", LIMBA_RTA_READS_HEAP)
/* BigInt (luxia_0.md § 3.12, progetto_ir.md § 11d): a ref counted as a
   str, immutable, 0 for the handle 0; every operation gives a new value.
   The checks come before, in the IR: a divisor is never 0, an exponent
   never negative (read without a sign), a real finite and integral */
LIMBA_RT(BIG_FROM_I64, "big_from_i64", "(i64) -> ref", LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_FROM_U64, "big_from_u64", "(i64) -> ref", LIMBA_RTA_ALLOC)
/* a constant past 64 bits: its decimal digits, a '-' first if negative */
LIMBA_RT(BIG_LIT, "big_lit", "(str) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
/* false, and nothing written, if the value does not fit */
LIMBA_RT(BIG_TO_I64, "big_to_i64", "(ref, ptr) -> i1", LIMBA_RTA_WRITES_MEM)
LIMBA_RT(BIG_TO_U64, "big_to_u64", "(ref, ptr) -> i1", LIMBA_RTA_WRITES_MEM)
/* the low 64 bits, in two's complement */
LIMBA_RT(BIG_TO_BITS, "big_to_bits", "(ref) -> i64", LIMBA_RTA_PURE)
LIMBA_RT(BIG_FROM_F64, "big_from_f64", "(f64) -> ref", LIMBA_RTA_ALLOC)
/* rounded once, to nearest even, straight to the type; past its largest
   finite value an infinity with the sign */
LIMBA_RT(BIG_TO_F64, "big_to_f64", "(ref) -> f64", LIMBA_RTA_PURE)
LIMBA_RT(BIG_TO_F32, "big_to_f32", "(ref) -> f32", LIMBA_RTA_PURE)
LIMBA_RT(BIG_ADD, "big_add", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_SUB, "big_sub", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_MUL, "big_mul", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_NEG, "big_neg", "(ref) -> ref", LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_ABS, "big_abs", "(ref) -> ref", LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
/* div truncates, rem has the sign of the dividend, mod of the divisor */
LIMBA_RT(BIG_DIV, "big_div", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_REM, "big_rem", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
LIMBA_RT(BIG_MOD, "big_mod", "(ref, ref) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
/* exact for the bases 0, 1 and -1 with any exponent (0 ** 0 is 1) */
LIMBA_RT(BIG_POW, "big_pow", "(ref, i64) -> ref",
         LIMBA_RTA_PURE | LIMBA_RTA_ALLOC)
/* exactly -1, 0 or 1 */
LIMBA_RT(BIG_CMP, "big_cmp", "(ref, ref) -> i32", LIMBA_RTA_PURE)
LIMBA_RT(BIG_SIGN, "big_sign", "(ref) -> i32", LIMBA_RTA_PURE)
LIMBA_RT(PRINT_BIG, "print_big", "(ref) -> void", LIMBA_RTA_IO)
LIMBA_RT(STR_FROM_BIG, "str_from_big", "(ref) -> str", LIMBA_RTA_ALLOC)
/* val: the text of an integer of Luxia (limba_val_big), any size */
LIMBA_RT(STR_TO_BIG, "str_to_big", "(str, ptr) -> i1", LIMBA_RTA_WRITES_MEM)
/* C strings (luxia_0.md § 9.9): memory of C, not of the program. new
   copies with a 0 after (a 0 inside is the trap RANGE, a failed malloc
   NOMEM); value copies up to the first 0, value_n n bytes (the pointer
   not null, n >= 0: checked before, in the IR); free frees what new or C
   made, null does nothing */
LIMBA_RT(CSTR_NEW, "cstr_new", "(str) -> ptr",
         LIMBA_RTA_ALLOC | LIMBA_RTA_MAY_TRAP)
LIMBA_RT(CSTR_VALUE, "cstr_value", "(ptr) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(CSTR_VALUE_N, "cstr_value_n", "(ptr, i64) -> str", LIMBA_RTA_ALLOC)
LIMBA_RT(CSTR_FREE, "cstr_free", "(ptr) -> void", LIMBA_RTA_WRITES_MEM)
/* the routines of arrays of luxia_0.md § 9.5, checked before, in the IR
   (count >= 0, the tract inside its array, the pattern not empty, nil
   and dangling): no trap, and with n = 0 no pointer is read. translate:
   a[i] := table[a[i]] for the n bytes at a, the 256 bytes of table read
   first (table may be a itself); reverse: the n elements of size bytes
   at a, in place, no str counted (a permutation); count: the
   non-overlapping occurrences of the m >= 1 bytes at p in the n bytes
   at a, searched from the left */
LIMBA_RT(MEM_TRANSLATE, "mem_translate", "(ptr, i64, ptr) -> void",
         LIMBA_RTA_WRITES_MEM)
LIMBA_RT(MEM_REVERSE, "mem_reverse", "(ptr, i64, i64) -> void",
         LIMBA_RTA_WRITES_MEM)
LIMBA_RT(MEM_COUNT, "mem_count", "(ptr, i64, ptr, i64) -> i64", 0)
