; recursive Fibonacci, printed by main; @early calls @late, defined after it
module "fib"
memory strict

func @fib : fn(i64) -> i64 {
b0(v0: i64):
  v1 = iconst i64 2
  v2 = icmp.slt i1 v0, v1
  cbr v2, b1, b2
b1:
  ret v0
b2:
  v3 = iconst i64 1
  v4 = sub i64 v0, v3
  v5 = call i64 @fib(v4)
  v6 = sub i64 v4, v3
  v7 = call i64 @fib(v6)
  v8 = add i64 v5, v7
  ret v8
}

func @main : fn() -> i64 export {
b0:
  v0 = iconst i64 30
  v1 = call i64 @fib(v0)
  call.rt void print_i64(v1)
  call.rt void print_nl()
  v2 = call i64 @early()
  ret v2
}

func @early : fn() -> i64 {
b0:
  v0 = call i64 @late()
  ret v0
}

func @late : fn() -> i64 {
b0:
  v0 = iconst i64 5
  ret v0
}
