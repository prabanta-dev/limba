; block parameters, switch, conversions, bit operations, checks
module "loop"
memory strict

; the sum of i * i for i < n, as a float
func @sumsq : fn(i64) -> f64 {
b0(v0: i64):
  v1 = iconst i64 0
  v2 = fconst f64 0x0p+0
  br b1(v1, v2)
b1(v3: i64, v4: f64):
  v5 = icmp.slt i1 v3, v0
  cbr v5, b2, b3
b2:
  v6 = mul i64 v3, v3
  v7 = sitofp f64 v6
  v8 = fadd f64 v4, v7
  v9 = iconst i64 1
  v10 = add i64 v3, v9
  br b1(v10, v8)
b3:
  ret v4
}

func @classify : fn(i32) -> i32 {
b0(v0: i32):
  switch v0, b3 [0: b1, 1: b2, -5: b2]
b1:
  v1 = iconst i32 10
  ret v1
b2:
  v2 = iconst i32 20
  ret v2
b3:
  v3 = iconst i32 -1
  v4 = fconst f32 0x1.8p+1
  v5 = fconst f32 nan.0x7ff8000000000001
  v6 = fcmp.uno i1 v4, v5
  v7 = iconst i32 7
  v8 = select i32 v6, v3, v7
  v9 = sext i64 v8
  v10 = trunc i16 v9
  v11 = zext i32 v10
  ret v11
}

func @bits : fn(i64, i64) -> i64 {
b0(v0: i64, v1: i64):
  v2 = shl i64 v0, v1
  v3 = lshr i64 v2, v1
  v4 = ashr i64 v3, v1
  v5 = and i64 v4, v0
  v6 = or i64 v5, v1
  v7 = xor i64 v6, v0
  v8 = not i64 v7
  v9 = neg i64 v8
  v10 = udiv i64 v9, v1
  v11 = srem i64 v10, v1
  v12 = add.ov i64 v11, v0
  v13 = iconst i64 -9223372036854775808
  v14 = icmp.ne i1 v12, v13
  check v14, 6
  v15 = sitofp f64 v12
  v16 = fneg f64 v15
  v17 = fma f64 v15, v16, v15
  v18 = fptosi i64 v17
  ret v18
}

; a value used in a block written before the one that defines it
func @forward : fn(i1) -> i64 {
b0(v0: i1):
  br b2
b1:
  v2 = add i64 v1, v1
  ret v2
b2:
  v1 = iconst i64 4
  cbr v0, b1, b3
b3:
  ret v1
}
