; the largest global and slot: 2^32 - 1 bytes (doc/ir.md § 2.2). A
; const global read; the function with the slot is never called
global @big : [4294967295 x i8] const
global @row : [2 x [2147483647 x i8]]

func @deep : fn() -> i64 {
  slot 4294967295 align 1
b0:
  v0 = slot ptr $0
  v1 = load i8 v0
  v2 = zext i64 v1
  ret v2
}

func @main : fn() -> i64 export {
b0:
  v0 = gaddr ptr @big
  v1 = iconst i64 7
  v2 = addr ptr v0, v1, 1, 0
  v3 = load i8 v2
  v4 = zext i64 v3
  ret v4
}
