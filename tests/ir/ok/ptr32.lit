; pointers of 32 bits: ptr, str and ref take 4 bytes, and the layouts the
; front end computes follow (an engine may refuse to run it)
module "ptr32"
ptr_bits 32

type %node = { ptr @0, str @4, i32 @8 } size 12 align 4

global @head : %node
global @nodes : [4 x ptr]

func @main : fn() -> i32 {
b0:
  v0 = gaddr ptr @head
  v1 = iconst i32 7
  v2 = iconst i64 1
  v3 = addr ptr v0, v2, 0, 8
  store v1, v3
  v4 = load i32 v3
  ret v4
}
