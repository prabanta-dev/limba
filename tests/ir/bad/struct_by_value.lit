; expect: argument 0 has the wrong type
; a struct by value is passed as the address of its bytes, a ptr
type %big = { i64 @0, i64 @8, i64 @16 } size 24 align 8
extern @sum : fn(%big) -> i64 = "probe_sum" in "probe"

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 1
  v1 = call.ext i64 @sum(v0)
  ret v1
}
