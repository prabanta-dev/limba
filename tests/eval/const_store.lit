; module: wrong
; a const global is never written (doc/ir.md § 3.4): a store the verifier
; sees, at an address computed from it, is not refused (as a store to
; null after a check that always fails, § 9.4) but is a wrong module
; when it runs
global @table : [4 x i32] = data "\x01\x00\x00\x00\x02" const

func @main : fn() -> i64 {
b0:
  v0 = gaddr ptr @table
  v1 = iconst i64 2
  v2 = addr ptr v0, v1, 4, 0
  v3 = iconst i32 7
  store v3, v2
  v4 = iconst i64 0
  ret v4
}
