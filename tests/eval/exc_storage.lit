; trap: 7
; out of memory is never caught (progetto_ir.md § 11i, D52): raised by
; the program in a protected block, it stops the program, and the handler
; does not run
func @main : fn() -> i64 {
b0:
  br b1
b1 handler b2:
  v0 = iconst i32 7
  v1 = iconst i32 0
  v2 = sconst str ""
  raise v0, v1, v2
b2(v3: i32, v4: i32, v5: str):
  v6 = sconst str "never"
  call.rt void print_str(v6)
  v7 = iconst i64 1
  ret v7
}
