; loops with block parameters; the Fibonacci jump swaps two of them, which
; must be a parallel copy; ten times 0.1 in f32
func @sumsq : fn(i64) -> i64 {
b0(v0: i64):
  v1 = iconst i64 0
  br b1(v1, v1)
b1(v2: i64, v3: i64):
  v4 = icmp.slt i1 v2, v0
  cbr v4, b2, b3
b2:
  v5 = mul i64 v2, v2
  v6 = add i64 v3, v5
  v7 = iconst i64 1
  v8 = add i64 v2, v7
  br b1(v8, v6)
b3:
  ret v3
}

func @fibit : fn(i64) -> i64 {
b0(v0: i64):
  v1 = iconst i64 0
  v2 = iconst i64 1
  br b1(v1, v2, v1)
b1(v3: i64, v4: i64, v5: i64):
  v6 = icmp.slt i1 v5, v0
  cbr v6, b2, b3
b2:
  v7 = add i64 v3, v4
  v8 = iconst i64 1
  v9 = add i64 v5, v8
  br b1(v4, v7, v9)
b3:
  ret v3
}

func @tenth : fn() -> f32 {
b0:
  v0 = fconst f32 0x0p+0
  v1 = iconst i32 0
  br b1(v0, v1)
b1(v2: f32, v3: i32):
  v4 = iconst i32 10
  v5 = icmp.slt i1 v3, v4
  cbr v5, b2, b3
b2:
  v6 = fconst f32 0x1.99999ap-4
  v7 = fadd f32 v2, v6
  v8 = iconst i32 1
  v9 = add i32 v3, v8
  br b1(v7, v9)
b3:
  ret v2
}

func @main : fn() -> i64 {
b0:
  v0 = iconst i64 10
  v1 = call i64 @sumsq(v0)
  call.rt void print_i64(v1)
  call.rt void print_nl()
  v2 = iconst i64 1000
  v3 = call i64 @sumsq(v2)
  call.rt void print_i64(v3)
  call.rt void print_nl()
  v4 = iconst i64 50
  v5 = call i64 @fibit(v4)
  call.rt void print_i64(v5)
  call.rt void print_nl()
  v6 = call f32 @tenth()
  v7 = fpext f64 v6
  call.rt void print_f64(v7)
  call.rt void print_nl()
  v8 = iconst i64 7
  ret v8
}
