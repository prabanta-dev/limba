; trap: 7
; 2 ** 2^40 is refused before it is computed: the trap NOMEM; the result
; is printed, so that no pass may drop the call (a value nobody uses may
; go, and the memory it would take with it)
func @main : fn() -> i64 {
b0:
  v0 = iconst i64 2
  v1 = call.rt ref big_from_i64(v0)
  v2 = iconst i64 1099511627776
  v3 = call.rt ref big_pow(v1, v2)
  call.rt void print_big(v3)
  v4 = iconst i64 0
  ret v4
}
