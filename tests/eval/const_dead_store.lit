; output: 2
; result: 0
; a store into a const global on a branch never taken is no error
; (doc/ir.md § 3.4): the module verifies and runs, also after inline
; puts the store right on the global with a condition known only when
; the program runs (-O1, by the OPTDIFF net)
global @table : [4 x i32] = data "\x01\x00\x00\x00\x02" const

func @put : fn(ptr, i1) -> void {
b0(v0: ptr, v1: i1):
  cbr v1, b1, b2
b1:
  v2 = iconst i64 1
  v3 = addr ptr v0, v2, 4, 0
  v4 = iconst i32 9
  store v4, v3
  br b2
b2:
  ret
}

func @main : fn() -> i64 {
b0:
  v0 = gaddr ptr @table
  v1 = null ptr
  v2 = iconst i64 0
  v3 = call.rt i64 io_read(v1, v2)
  v4 = icmp.ne i1 v3, v2
  call void @put(v0, v4)
  v5 = iconst i64 1
  v6 = addr ptr v0, v5, 4, 0
  v7 = load i32 v6
  v8 = sext i64 v7
  call.rt void print_i64(v8)
  call.rt void print_nl()
  ret v2
}
