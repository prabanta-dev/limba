; the passes and the handlers (progetto_ir.md § 11i): blocks with
; different handlers stay apart; a check of a protected loop stays in it,
; its way in being unprotected; a function put in line in a protected
; block takes its handler
func @apart : fn(i64) -> i64 {
b0(v0: i64):
  br b1
b1 handler b3:
  v1 = iconst i64 0
  v2 = icmp.sge i1 v0, v1
  check v2, 101
  br b2
b2:
  ret v0
b3(v3: i32, v4: i32, v5: str):
  v6 = iconst i64 -1
  ret v6
}

func @loop : fn(i64, i1) -> i64 {
b0(v0: i64, v1: i1):
  v2 = iconst i64 0
  br b1(v2)
b1(v3: i64) handler b3:
  check v1, 101
  v4 = iconst i64 1
  v5 = add i64 v3, v4
  v6 = icmp.slt i1 v5, v0
  cbr v6, b1(v5), b2
b2:
  ret v3
b3(v7: i32, v8: i32, v9: str):
  v10 = iconst i64 -1
  ret v10
}

func @small : fn(i1) -> i64 {
b0(v0: i1):
  check v0, 100
  v1 = iconst i64 1
  ret v1
}

func @caller : fn(i1) -> i64 {
b0(v0: i1):
  br b1
b1 handler b2:
  v1 = call i64 @small(v0)
  ret v1
b2(v2: i32, v3: i32, v4: str):
  v5 = iconst i64 0
  ret v5
}

