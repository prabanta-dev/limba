; nothing here may fold: it would trap or overflow, signed or not; a shift
; by the width or more folds, the count modulo the width (1 << 64 is 1)
func @f : fn() -> i64 {
b0:
  v0 = iconst i64 10
  v1 = iconst i64 0
  v2 = sdiv i64 v0, v1
  v3 = iconst i64 -9223372036854775808
  v4 = iconst i64 -1
  v5 = sdiv i64 v3, v4
  v6 = iconst i64 9223372036854775807
  v7 = iconst i64 1
  v8 = add.ov i64 v6, v7
  v9 = iconst i64 64
  v10 = shl i64 v7, v9
  v11 = add i64 v2, v5
  v12 = add i64 v11, v8
  v13 = add i64 v12, v10
  v14 = uadd.ov i64 v4, v7
  v15 = usub.ov i64 v1, v7
  v16 = umul.ov i64 v4, v0
  v17 = add i64 v13, v14
  v18 = add i64 v17, v15
  v19 = add i64 v18, v16
  ret v19
}
