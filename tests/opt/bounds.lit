; bounds: a check the facts before it prove goes, one they do not prove
; stays, at the very edge of each difference; of a check of a and b only
; the half not proved stays
func @edge : fn(i64, i64) -> void {
b0(v0: i64, v1: i64):
  v2 = icmp.sle i1 v0, v1
  cbr v2, b1, b2
b1:
  v3 = iconst i64 1
  v4 = sub.ov i64 v0, v3
  v5 = icmp.sle i1 v4, v1
  check v5, 100
  v6 = add.ov i64 v0, v3
  v7 = icmp.sle i1 v6, v1
  check v7, 100
  v8 = icmp.slt i1 v0, v1
  check v8, 100
  v9 = icmp.slt i1 v4, v1
  check v9, 100
  ret
b2:
  v10 = icmp.sgt i1 v0, v1
  check v10, 101
  v11 = icmp.sge i1 v0, v1
  check v11, 101
  v12 = iconst i64 1
  v13 = add.ov i64 v1, v12
  v14 = icmp.sge i1 v0, v13
  check v14, 101
  v15 = icmp.sgt i1 v0, v13
  check v15, 101
  ret
}
func @loop : fn(i64, i64) -> void {
b0(v0: i64, v1: i64):
  br b1(v0)
b1(v2: i64):
  v3 = icmp.sge i1 v2, v0
  check v3, 100
  v4 = icmp.sgt i1 v2, v0
  check v4, 100
  v5 = icmp.sle i1 v2, v1
  v6 = icmp.sge i1 v2, v0
  v7 = and i1 v6, v5
  check v7, 100
  v8 = iconst i64 1
  v9 = add.ov i64 v2, v8
  v10 = icmp.slt i1 v9, v1
  cbr v10, b1(v9), b2
b2:
  ret
}
;; expect
func @edge : fn(i64, i64) -> void {
b0(v0: i64, v1: i64):
  v2 = icmp.sle i1 v0, v1
  cbr v2, b1, b2
b1:
  v3 = iconst i64 1
  v4 = sub.ov i64 v0, v3
  v5 = add.ov i64 v0, v3
  v6 = icmp.sle i1 v5, v1
  check v6, 100
  ret
b2:
  v7 = iconst i64 1
  v8 = add.ov i64 v1, v7
  v9 = icmp.sgt i1 v0, v8
  check v9, 101
  ret
}

func @loop : fn(i64, i64) -> void {
b0(v0: i64, v1: i64):
  br b1(v0)
b1(v2: i64):
  v3 = icmp.sgt i1 v2, v0
  check v3, 100
  v4 = icmp.sle i1 v2, v1
  check v4, 100
  v5 = iconst i64 1
  v6 = add.ov i64 v2, v5
  v7 = icmp.slt i1 v6, v1
  cbr v7, b1(v6), b2
b2:
  ret
}
