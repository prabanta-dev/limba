; equal values merge only where one dominates the other; divisions that
; may trap never merge
func @f : fn(i64, i64, i1) -> i64 {
b0(v0: i64, v1: i64, v2: i1):
  v3 = add i64 v0, v1
  cbr v2, b1, b2
b1:
  v4 = add i64 v1, v0
  br b3(v4)
b2:
  v5 = mul i64 v0, v1
  br b3(v5)
b3(v6: i64):
  v7 = mul i64 v0, v1
  v8 = add i64 v6, v7
  v9 = sdiv i64 v8, v0
  v10 = sdiv i64 v8, v0
  v11 = add i64 v9, v10
  ret v11
}
;; expect
func @f : fn(i64, i64, i1) -> i64 {
b0(v0: i64, v1: i64, v2: i1):
  v3 = add i64 v0, v1
  cbr v2, b1, b2
b1:
  br b3(v3)
b2:
  v4 = mul i64 v0, v1
  br b3(v4)
b3(v5: i64):
  v6 = mul i64 v0, v1
  v7 = add i64 v5, v6
  v8 = sdiv i64 v7, v0
  v9 = sdiv i64 v7, v0
  v10 = add i64 v8, v9
  ret v10
}
