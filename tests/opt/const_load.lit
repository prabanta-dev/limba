; a load from a const global at an offset known here is the number of
; its initial bytes (doc/ir.md ยง 3.4): data and fills, an integer, a
; real, the lowest bit for an i1. Not folded: a global that is not
; const, the bytes of a relocation, an offset past the global
global @table : [4 x i32] = data "\x01\x00\x00\x00\xfe\xff\xff\xff" fill 8 2 "\x07\x00\x00\x00" const
global @count : i64 = -3 const
global @scale : f64 = 0x1.8p+1 const
global @flag : i8 = 3 const
global @var : i64 = 4
global @ref : ptr = data "" reloc 0 global @count const

func @ints : fn() -> i64 {
b0:
  v0 = gaddr ptr @table
  v1 = iconst i64 1
  v2 = addr ptr v0, v1, 4, 0
  v3 = load i32 v2
  v4 = sext i64 v3
  v5 = iconst i64 3
  v6 = addr ptr v0, v5, 4, 0
  v7 = load i32 v6
  v8 = sext i64 v7
  v9 = add i64 v4, v8
  v10 = gaddr ptr @count
  v11 = load i64 v10
  v12 = add i64 v9, v11
  v13 = addr ptr v0, v1, 0, 1
  v14 = load i16 v13
  v15 = zext i64 v14
  v16 = add i64 v12, v15
  ret v16
}

func @others : fn() -> f64 {
b0:
  v0 = gaddr ptr @scale
  v1 = load f64 v0
  v2 = gaddr ptr @flag
  v3 = load i1 v2
  v4 = gaddr ptr @var
  v5 = load i64 v4
  v6 = gaddr ptr @ref
  v7 = load i64 v6
  v8 = add i64 v5, v7
  v9 = gaddr ptr @table
  v10 = iconst i64 4
  v11 = addr ptr v9, v10, 4, 0
  v12 = load i32 v11
  v13 = sext i64 v12
  v14 = add i64 v8, v13
  v15 = sitofp f64 v14
  v16 = fadd f64 v1, v15
  v17 = select f64 v3, v16, v1
  ret v17
}
