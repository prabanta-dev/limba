; the mathematics of the run time on constants, by limba/math.h: sin,
; pow, a square root; a NaN stays for run time, as an argument that is
; not a constant
func @consts : fn() -> f64 {
b0:
  v0 = fconst f64 0x1p-1
  v1 = call.rt f64 math_sin(v0)
  v2 = fconst f64 0x1p+1
  v3 = fconst f64 0x1.4p+3
  v4 = call.rt f64 math_pow(v2, v3)
  v5 = fadd f64 v1, v4
  v6 = call.rt f64 math_sqrt(v2)
  v7 = fadd f64 v5, v6
  ret v7
}

func @kept : fn(f64) -> f64 {
b0(v0: f64):
  v1 = fconst f64 -0x1p+0
  v2 = call.rt f64 math_ln(v1)
  v3 = call.rt f64 math_exp(v0)
  v4 = fadd f64 v2, v3
  ret v4
}

