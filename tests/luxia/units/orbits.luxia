//
// A program with units (specification § 11): Geometry and Text are units
// of the program, Strings one of the standard library (limba
// --stdlib=tests/luxia/units/std). Names direct or qualified, a variable
// of an interface read outside its unit, initialisations before the
// program, in the order of what they use.
program Orbits;

uses Geometry, Strings;

var a, b: Vector;
  c: Geometry.Vector;
begin
  a.x := 0.0;
  a.y := 0.0;
  a.z := 0.0;
  b.x := 3.0;
  b.y := 4.0;
  b.z := 12.0;
  c := b;
  writeln(Distance(a, b), " ", Geometry.Distance(c, a));
  writeln(Strings.Times("=", Geometry.calls * 4));
end Orbits.
