// The Computer Language Benchmarks Game
// https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
//
// fannkuch-redux in Luxia 0: the permutations in the order of the
// reference programs, counted with a checksum that alternates its sign.
program FannkuchRedux;

var
  checksum: Int64 := 0;
  maxFlips: Int32 := 0;

procedure Fannkuch(n: Int32);
var
  p, q, s: array[Int32 range 1..n] of Int32;
  sign: Int32 := 1;
begin
  for var i := 1 to n do
    p[i] := i;
    q[i] := i;
    s[i] := i;
  end;

  loop
    // copy and flip
    var q1 := p[1];
    if q1 <> 1 then
      for var i := 2 to n do
        q[i] := p[i];
      end;
      var flips: Int32 := 1;
      loop
        var qq := q[q1];
        if qq = 1 then
          checksum := checksum + Int64(sign * flips);
          if flips > maxFlips then
            maxFlips := flips;
          end;
          exit;
        end;
        q[q1] := q1;
        if q1 >= 4 then
          var i: Int32 := 2;
          var j := q1 - 1;
          repeat
            var sw := q[i];
            q[i] := q[j];
            q[j] := sw;
            i := i + 1;
            j := j - 1;
          until i >= j;
        end;
        q1 := qq;
        flips := flips + 1;
      end;
    end;

    // next permutation
    if sign = 1 then
      var sw := p[2];
      p[2] := p[1];
      p[1] := sw;
      sign := -1;
    else
      var sw := p[2];
      p[2] := p[3];
      p[3] := sw;
      sign := 1;
      for var i := 3 to n do
        var sx := s[i];
        if sx <> 1 then
          s[i] := sx - 1;
          exit;
        end;
        if i = n then
          return;
        end;
        s[i] := i;
        // rotate 1 <- ... <- i+1
        var t := p[1];
        for var j := 1 to i do
          p[j] := p[j + 1];
        end;
        p[i + 1] := t;
      end;
    end;
  end;
end Fannkuch;

begin
  // the size comes from the command line, 7 without one
  var n: Int32 := 7;
  if argcount() > 0 then
    if not val(arg(1), n) then
      halt(1);
    end;
  end;

  Fannkuch(n);
  writeln(checksum);
  writeln("Pfannkuchen(", n, ") = ", maxFlips);
end FannkuchRedux.
