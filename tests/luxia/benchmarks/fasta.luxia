// The Computer Language Benchmarks Game
// https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
//
// fasta in Luxia: a repeated sequence, then two random ones from the
// linear congruential generator of the reference programs, 60 characters
// to a line. The tables are typed constants, written as aggregates.
program Fasta;

const
  LineLength = 60;
  Im = 139968;
  Ia = 3877;
  Ic = 29573;

type
  Codes = array[Int32 range 1..15] of Char;
  Odds = array[Int32 range 1..15] of Float64;

const
  IubChars: Codes = {'a', 'c', 'g', 't', 'B', 'D', 'H', 'K', 'M', 'N', 'R',
                     'S', 'V', 'W', 'Y'};
  IubWeights: Odds = {1: 0.27, 2..3: 0.12, 4: 0.27, else 0.02};
  SapiensChars: Codes = {'a', 'c', 'g', 't', else ' '};
  SapiensWeights: Odds = {0.3029549426680, 0.1979883004921,
                          0.1975473066391, 0.3015094502008, else 0.0};

var
  last: Int64 := 42;
  iubOdds, sapiensOdds: Odds;

function NextRandom(): Float64;
begin
  last := (last * Ia + Ic) mod Im;
  return Float64(last) / Float64(Im);
end NextRandom;

procedure RepeatFasta(id, desc, s: String; n: Int64);
begin
  writeln(">", id, " ", desc);
  var sn := length(s);
  var s2 := s & s;
  var p: Int64 := 1;
  var i: Int64 := LineLength;
  while i <= n do
    writeln(copy(s2, p, LineLength));
    p := p + LineLength;
    if p > sn then
      p := p - sn;
    end;
    i := i + LineLength;
  end;
  var tail := n mod LineLength;
  if tail > 0 then
    writeln(copy(s2, p, tail));
  end;
end RepeatFasta;

// the odds are cumulative: the first code whose odds exceed the random
// number is the one written
procedure RandomFasta(id, desc: String; chars: Codes; odds: Odds;
                      count: Int32; n: Int64);
begin
  writeln(">", id, " ", desc);
  var produced: Int64 := 0;
  while produced < n do
    var thisLine: Int64 := LineLength;
    if n - produced < LineLength then
      thisLine := n - produced;
    end;
    for var k: Int64 := 1 to thisLine do
      var r := NextRandom();
      var idx := count;
      for var j := 1 to count do
        if r < odds[j] then
          idx := j;
          exit;
        end;
      end;
      write(chars[idx]);
    end;
    writeln();
    produced := produced + thisLine;
  end;
end RandomFasta;

// the odds of the first count codes: their weights, added up
procedure Cumulate(weights: Odds; count: Int32; out odds: Odds);
begin
  odds := {else 0.0};
  odds[1] := weights[1];
  for var i := 2 to count do
    odds[i] := odds[i - 1] + weights[i];
  end;
end Cumulate;

begin
  // the size comes from the command line, 1000 without one
  var n: Int32 := 1000;
  if argcount() > 0 then
    if not val(arg(1), n) then
      halt(2);
    end;
  end;

  var alu := "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" &
             "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" &
             "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" &
             "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" &
             "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" &
             "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" &
             "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA";

  Cumulate(IubWeights, 15, iubOdds);
  Cumulate(SapiensWeights, 4, sapiensOdds);

  RepeatFasta("ONE", "Homo sapiens alu", alu, Int64(n) * 2);
  RandomFasta("TWO", "IUB ambiguity codes", IubChars, iubOdds, 15,
              Int64(n) * 3);
  RandomFasta("THREE", "Homo sapiens frequency", SapiensChars,
              sapiensOdds, 4, Int64(n) * 5);
end Fasta.
