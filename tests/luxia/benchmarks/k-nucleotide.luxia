// The Computer Language Benchmarks Game
// https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
//
// k-nucleotide in Luxia 0: reads the output of fasta, keeps the sequence
// THREE and counts its fragments in a hash table written by hand, with
// open addressing, made by new and twice as large each time it is half
// full. A fragment of k nucleotides is a key of 2k bits; for one k the
// order of the keys is the alphabetical order of the fragments.
program KNucleotide;

type
  Lines = ^Piece;
  Piece = record
    text: String;
    next: Lines;
  end;
  Codes = array[Byte] of Bits64;
  Sequence = array[Int64 range <>] of Bits64;
  // a slot of the table: a count of 0 is a free one
  Entry = record
    key: Bits64;
    count: Int64;
  end;
  Table = array[Int64 range <>] of Entry;
  TableRef = ^Table;

var
  code: Codes;

// the table twice as large, its keys hashed again; the old one freed
function Grow(old: TableRef): TableRef;
begin
  var t := new(Table range 0..2 * length(old^) - 1);
  var mask := Bits64(length(t^) - 1);
  for var i := low(old^) to high(old^) do
    var e := old[i];
    if e.count <> 0 then
      var p := Int64((e.key * 2654435761) and mask);
      while t[p].count <> 0 do
        p := Int64((Bits64(p) + 1) and mask);
      end;
      t[p] := e;
    end;
  end;
  dispose(old);
  return t;
end Grow;

// counts every fragment of k nucleotides of the sequence in a table of
// 64 slots at first, twice as large each time it is half full; a slot
// is read once per probe
function CountFrames(dna: Sequence; k: Int32): TableRef;
begin
  var t := new(Table range 0..63);
  var mask: Bits64 := 63;
  var filled: Int64 := 0;
  var bits := (Bits64(1) shl (2 * k)) - 1;
  var acc: Bits64 := 0;
  for var i := low(dna) to high(dna) do
    acc := ((acc shl 2) or dna[i]) and bits;
    if i - low(dna) >= Int64(k) - 1 then
      var p := Int64((acc * 2654435761) and mask);
      var e := t[p];
      while e.count <> 0 and e.key <> acc do
        p := Int64((Bits64(p) + 1) and mask);
        e := t[p];
      end;
      if e.count = 0 then
        t[p].key := acc;
        t[p].count := 1;
        filled := filled + 1;
        if 2 * filled > length(t^) then
          t := Grow(t);
          mask := Bits64(length(t^) - 1);
        end;
      else
        t[p].count := e.count + 1;
      end;
    end;
  end;
  return t;
end CountFrames;

function Count(k: Bits64; t: TableRef): Int64;
begin
  var mask := Bits64(length(t^) - 1);
  var p := Int64((k * 2654435761) and mask);
  var e := t[p];
  while e.count <> 0 do
    if e.key = k then
      return e.count;
    end;
    p := Int64((Bits64(p) + 1) and mask);
    e := t[p];
  end;
  return 0;
end Count;

function Fragment(k: Bits64; n: Int32): String;
begin
  var s := "";
  for var i := n - 1 downto 0 do
    s := s & copy("ACGT", Int64((k shr (2 * i)) and 3) + 1, 1);
  end;
  return s;
end Fragment;

function KeyOf(s: String): Bits64;
begin
  var k: Bits64 := 0;
  for var i := 1 to length(s) do
    k := (k shl 2) or code[s[i]];
  end;
  return k;
end KeyOf;

// every fragment of k nucleotides with its share, the most frequent first
procedure Frequency(dna: Sequence; k: Int32);
begin
  var t := CountFrames(dna, k);
  var total: Int64 := 1;
  for var i := 1 to k do
    total := total * 4;
  end;
  var names: array[Int64 range 0..total - 1] of Bits64;
  var times: array[Int64 range 0..total - 1] of Int64;
  for var i := 0 to total - 1 do
    names[i] := Bits64(i);
    times[i] := Count(Bits64(i), t);
  end;
  // insertion sort: more frequent first, then alphabetical
  for var i := 1 to total - 1 do
    var name := names[i];
    var times1 := times[i];
    var j := i - 1;
    while j >= 0 do
      exit when times[j] > times1;
      exit when times[j] = times1 and names[j] < name;
      names[j + 1] := names[j];
      times[j + 1] := times[j];
      j := j - 1;
    end;
    names[j + 1] := name;
    times[j + 1] := times1;
  end;
  var frames := Float64(length(dna) - Int64(k) + 1);
  for var i := 0 to total - 1 do
    writeln(Fragment(names[i], k), " ",
            Float64(times[i]) * 100.0 / frames:0:3);
  end;
  writeln();
  dispose(t);
end Frequency;

procedure CountFragment(dna: Sequence; s: String);
begin
  var t := CountFrames(dna, Int32(length(s)));
  writeln(Count(KeyOf(s), t), TAB, s);
  dispose(t);
end CountFragment;

begin
  for var b := low(code) to high(code) do
    code[b] := 0;
  end;
  code[65] := 0;   // A
  code[97] := 0;
  code[67] := 1;   // C
  code[99] := 1;
  code[71] := 2;   // G
  code[103] := 2;
  code[84] := 3;   // T
  code[116] := 3;

  // the lines of THREE, the last one first
  var lines: Lines := nil;
  var size: Int64 := 0;
  var inThree := false;
  var line: String;
  while readline(line) do
    continue when length(line) = 0;
    if line[1] = 62 then          // '>'
      exit when inThree;
      inThree := copy(line, 1, 6) = ">THREE";
    elsif inThree and line[1] <> 59 then
      var p := new(Piece);
      p.text := line;
      p.next := lines;
      lines := p;
      size := size + length(line);
    end;
  end;

  var dna: array[Int64 range 1..size] of Bits64;
  var at := size;
  while lines <> nil do
    var s := lines.text;
    for var i := length(s) downto 1 do
      dna[at] := code[s[i]];
      at := at - 1;
    end;
    var done := lines;
    lines := lines.next;
    dispose(done);
  end;

  Frequency(dna, 1);
  Frequency(dna, 2);
  CountFragment(dna, "GGT");
  CountFragment(dna, "GGTA");
  CountFragment(dna, "GGTATT");
  CountFragment(dna, "GGTATTTTAATT");
  CountFragment(dna, "GGTATTTTAATTTATAGT");
end KNucleotide.
